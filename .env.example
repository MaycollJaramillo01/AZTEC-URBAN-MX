# Keep preview indexing disabled until content and rights are approved.
SITE_INDEXABLE=false
# Set only to the verified production origin before launch (https://example.com).
SITE_URL=

# Contact form: enable only after configuring and verifying your existing SMTP.
CONTACT_FORM_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (usually 587); true = TLS from connect (usually 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Bare email addresses. FROM must be authorized by your existing provider.
SMTP_FROM=
SMTP_TO=info@aztecmx.com
